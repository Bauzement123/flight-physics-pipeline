# ─────────────────────────────────────────────────────────────────
# Flight Physics Pipeline — Local Node Configuration
# ─────────────────────────────────────────────────────────────────
# Copy this file to .env and set values for your deployment node.
# .env is gitignored — changes here never touch the repository.
#
# ERA5 weather I/O tuning
# ─────────────────────────────────────────────────────────────────
# Number of concurrent ThreadPoolExecutor workers for ERA5 packet loading.
# Lower values reduce concurrent NetCDF file handles on SMB/NFS mounts.
# VM / network mount:  1
# Local NVMe SSD:      2
WEATHER_IO_WORKERS=2

# Number of ERA5 hours per discrete load packet.
# Smaller packets (1–3 h) bound peak open file handles on high-latency mounts.
# Larger packets (12–24 h) reduce ERA5 object construction overhead on fast disks.
# VM / network mount:  1
# Local NVMe SSD:      12
WEATHER_OPEN_PACKET_HOURS=12

# ─────────────────────────────────────────────────────────────────
# HDF5 / NetCDF4 file locking
# ─────────────────────────────────────────────────────────────────
# Set to FALSE on SMB/NFS mounts to prevent HDF5 lock acquisition errors.
# Leave unset (or set to TRUE) on local filesystems.
# HDF5_USE_FILE_LOCKING=FALSE
